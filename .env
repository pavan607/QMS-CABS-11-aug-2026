# Database Configuration
# Format: postgresql://username:password@host:port/database
# Local dev (no Docker): localhost is fine.
# Docker: use host.docker.internal instead of localhost so the container reaches Postgres on the host.
DATABASE_URL=postgresql://postgres:root@localhost:5432/QMS
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=6Qe3wv9nxirulGt7Wf9Xiwy0MJsjhrFh26/JIi06Btc=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Email Configuration (Optional - for notifications)
